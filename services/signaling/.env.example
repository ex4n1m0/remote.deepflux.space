# services/signaling environment variables (M3).
# Copy values into your shell or a local .env (never commit real values).
# Names only here — placeholder values, no secrets.

# --- External ephemeral store (Upstash Redis REST) -------------------------
# Production: your Upstash Redis REST URL and token.
# Local dev: the bundled emulator, e.g. http://127.0.0.1:38001 with any
# non-empty token.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:38001
UPSTASH_REDIS_REST_TOKEN=local-emulator-token

# --- TTLs (seconds); defaults follow the source plan ranges ---------------
SIGNALING_TTL_DEVICE_SECONDS=45        # presence heartbeat TTL (30-60)
SIGNALING_TTL_MAILBOX_SECONDS=180      # per-device mailbox TTL (120-300)
SIGNALING_TTL_SESSION_SECONDS=480      # session record TTL (300-600)
SIGNALING_TTL_DEDUPE_SECONDS=120       # message_id dedupe window

# --- Bounds ----------------------------------------------------------------
SIGNALING_MAILBOX_MAX=256              # max entries per device mailbox
SIGNALING_MAILBOX_BATCH=64             # max entries per delivery drain
SIGNALING_ENVELOPE_MAX_BYTES=32768     # max accepted envelope JSON size
SIGNALING_WS_POLL_MS=250               # mailbox drain interval per WS conn
SIGNALING_MAX_CONNECTION_SECONDS=290   # graceful WS bye before maxDuration
SIGNALING_STORE_PREFIX=sg1:            # Redis key namespace
