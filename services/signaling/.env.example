# services/signaling environment variables (M3).
# Copy values into your shell or a local .env (never commit real values).
# Names only here — placeholder values, no secrets.

# --- External ephemeral store (Upstash Redis REST) -------------------------
# Production: your Upstash Redis REST URL and token.
# Local dev: the bundled emulator, e.g. http://127.0.0.1:38001 with any
# non-empty token.
# KV_REST_API_URL / KV_REST_API_TOKEN (Vercel Upstash marketplace names) also work.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:38001
UPSTASH_REDIS_REST_TOKEN=local-emulator-token

# --- TTLs (seconds); defaults follow the source plan ranges ---------------
SIGNALING_TTL_DEVICE_SECONDS=45        # presence heartbeat TTL (30-60)
SIGNALING_TTL_MAILBOX_SECONDS=180      # per-device mailbox TTL (120-300)
SIGNALING_TTL_SESSION_SECONDS=480      # session record TTL (300-600)
SIGNALING_TTL_DEDUPE_SECONDS=120       # message_id dedupe window

# --- Bounds ----------------------------------------------------------------
SIGNALING_MAILBOX_MAX=256              # max entries per device mailbox
SIGNALING_MAILBOX_BATCH=64             # max entries per delivery drain
SIGNALING_ENVELOPE_MAX_BYTES=32768     # max accepted envelope JSON size
SIGNALING_WS_POLL_MS=250               # mailbox drain interval per WS conn
SIGNALING_MAX_CONNECTION_SECONDS=290   # graceful WS bye before maxDuration
SIGNALING_STORE_PREFIX=sg1:            # Redis key namespace

# --- Account & roster API (POST /api/account; accounts phase 2026-10-01) ----
SIGNALING_TTL_ACCOUNT_SESSION_SECONDS=2592000   # session token TTL (30 days)
SIGNALING_TTL_ACCOUNT_SECONDS=315532800         # account+roster record TTL (~10y)
SIGNALING_ROSTER_MAX_CIPHERTEXT_BYTES=65536     # roster ciphertext cap (413 above)
# Rate limits (fixed windows; only well-formed requests consume quota):
SIGNALING_RL_REGISTER_PER_HOUR=10       # register per IP per hour
SIGNALING_RL_REGISTER_GLOBAL_PER_DAY=500 # register, all IPs combined, per day
SIGNALING_RL_LOGIN_PRE_PER_MIN=120      # login_pre per IP per minute
SIGNALING_RL_LOGIN_PER_USER_15M=20      # login per username per 15 min
SIGNALING_RL_LOGIN_PER_IP_15M=60        # login per IP per 15 min
SIGNALING_RL_ROSTER_PUT_PER_MIN=60      # roster_put per username per minute
SIGNALING_RL_PRESENCE_PER_MIN=60        # presence per username per minute

# --- Circle directory API (POST /api/directory; ADR-006, 2026-10-26) ---------
SIGNALING_TTL_DIRECTORY_SECONDS=2592000        # entry TTL (30 days; self-cleaning)
SIGNALING_DIRECTORY_MAX_MEMBERS=128            # distinct devices per circle (409 above)
SIGNALING_DIRECTORY_ENTRY_MAX_BYTES=2048       # sealed-entry ciphertext cap (413 above)
SIGNALING_RL_DIR_PUT_PER_MIN_PER_DEVICE=10     # directory put per device per minute
SIGNALING_RL_DIR_PUT_PER_MIN_PER_IP=60         # directory put per IP per minute
SIGNALING_RL_DIR_PUT_NEW_MEMBERS_PER_DAY_PER_CIRCLE=5  # new members per circle per day
SIGNALING_RL_DIR_LIST_PER_MIN_PER_DEVICE=60    # directory list per device per minute
SIGNALING_RL_DIR_LIST_PER_MIN_PER_CIRCLE=300   # directory list per circle per minute
SIGNALING_RL_DIR_REMOVE_PER_MIN_PER_DEVICE=10  # directory remove per device per minute

# --- Signaling send-path rate limits (ADR-006 prompt-flood defense) ---------
SIGNALING_RL_SEND_PER_MIN_PER_DEVICE=60        # envelopes per sender per minute
SIGNALING_RL_CONNECT_PER_MIN_PER_PAIR=5        # connect_request per sender+target per minute
