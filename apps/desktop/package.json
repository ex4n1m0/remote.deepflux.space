{
  "name": "@remote/desktop-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tauri 2 + React product shell for the P2P Remote Desktop (M4, RD-011/RD-012). No frames ever pass through this layer (AGENTS.md invariant 1).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
